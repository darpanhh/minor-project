# ──────────────────────────────────────────────────────────────
# .env.sample — Copy this file to .env and fill in your values.
# DO NOT commit your real .env to version control.
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/proctor_db

# Optional: dedicated URL for tests. If unset, tests reuse DATABASE_URL and
# force an isolated "proctor_test" schema via the connection search_path.
# TEST_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/proctor_db

# JWT configuration
# Generate a strong secret, e.g.:  openssl rand -hex 64
JWT_SECRET=your_super_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30

# App settings
DEBUG=False
UPLOAD_DIR=uploads

# YOLO model path (relative to the backend/ directory)
# Use your fine-tuned weights (e.g. best.pt) or a pretrained model (e.g. yolov8n.pt)
MODEL_PATH=best.pt
